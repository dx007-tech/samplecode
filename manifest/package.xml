    </types>

    <!-- Apex Triggers -->
    <types>
        <members>*</members>
        <name>ApexTrigger</name>
    </types>

    <!-- Visualforce Pages -->
    <types>
        <members>*</members>
        <name>ApexPage</name>
    </types>

    <!-- Lightning Web Components (LWC) -->
